# The connector a bank runs inside its own network. Deliberately small: it carries
# only the hashing and forwarding code, none of the TrailGuard service.
FROM python:3.12-slim
RUN pip install --no-cache-dir "httpx>=0.27" "fastapi>=0.115" "uvicorn>=0.30"
WORKDIR /app
COPY connector/__init__.py connector/__main__.py connector/hashing.py connector/service.py connector/
ENV PYTHONUNBUFFERED=1
VOLUME /data
EXPOSE 8088
ENTRYPOINT ["python", "-m", "connector", "run"]
CMD ["/config/connector.toml"]
