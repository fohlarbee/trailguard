# Copy to .env for local development. These values are for a local machine only.
DATABASE_URL=postgresql://trailguard:trailguard@localhost:5433/trailguard

# Shared network salt used by every connector to hash identifiers. Keep it secret in production.
TRAILGUARD_SALT=local-dev-salt

# One API key per institution, as BANK:KEY pairs.
TRAILGUARD_API_KEYS=BNK01:dev-bnk01,BNK02:dev-bnk02,BNK03:dev-bnk03,BNK04:dev-bnk04,FIN01:dev-fin01,FIN02:dev-fin02

# Claude API key for the case investigator agent (https://platform.claude.com).
# Uncomment and fill in to run `python -m agent investigate`.
# ANTHROPIC_API_KEY=

# Replayed simulator data only: start the service clock at this moment (it then ticks
# normally). Anything dated later is treated as not having happened yet. Remove for live data.
TRAILGUARD_CLOCK=2026-10-06T09:00:00+01:00
